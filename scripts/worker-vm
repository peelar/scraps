#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
VM_NAME=${SCRAPS_VM_NAME:-scraps}
CONFIG_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/scraps/worker.conf
VM_CPUS=4
VM_MEMORY_GIB=8
VM_DISK_GIB=60

load_config() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  while IFS='=' read -r key value; do
    key=${key//[[:space:]]/}
    value=${value//[[:space:]]/}
    [[ -z "$key" || "$key" == \#* ]] && continue
    case "$key" in
      cpus) VM_CPUS=$value ;;
      memory_gib) VM_MEMORY_GIB=$value ;;
      disk_gib) VM_DISK_GIB=$value ;;
      *) echo "scraps: unknown worker setting '$key' in $CONFIG_FILE" >&2; exit 1 ;;
    esac
  done <"$CONFIG_FILE"
  [[ "$VM_CPUS" =~ ^[0-9]+$ && "$VM_CPUS" -ge 1 ]] || { echo "scraps: invalid CPU count in $CONFIG_FILE" >&2; exit 1; }
  [[ "$VM_MEMORY_GIB" =~ ^[0-9]+$ && "$VM_MEMORY_GIB" -ge 2 ]] || { echo "scraps: invalid memory size in $CONFIG_FILE" >&2; exit 1; }
  [[ "$VM_DISK_GIB" =~ ^[0-9]+$ && "$VM_DISK_GIB" -ge 10 ]] || { echo "scraps: invalid disk size in $CONFIG_FILE" >&2; exit 1; }
}

load_config

usage() {
  cat <<EOF
usage: scripts/worker-vm <up|stop|delete|status|shell>

Manage the local Lima worker VM. Run 'scrap configure' to set its size before
creation. Set SCRAPS_VM_NAME to use a different instance.
EOF
}

require_lima() {
  if ! command -v limactl >/dev/null 2>&1; then
    echo "scraps: Lima 2.0+ is required for the local worker VM" >&2
    echo "install it from https://lima-vm.io/ and rerun 'make up'" >&2
    exit 1
  fi
}

vm_status() {
  limactl list "$VM_NAME" --format '{{.Status}}' 2>/dev/null || true
}

start_vm() {
  local status
  status=$(vm_status)
  case "$status" in
    Running) ;;
    Stopped) limactl start "$VM_NAME" ;;
    *)
      echo "Creating worker VM: $VM_CPUS CPUs, $VM_MEMORY_GIB GiB memory, $VM_DISK_GIB GiB disk"
      limactl start --tty=false --name "$VM_NAME" --cpus "$VM_CPUS" --memory "$VM_MEMORY_GIB" --disk "$VM_DISK_GIB" "$ROOT/vm/lima.yaml"
      ;;
  esac
}

guest_arch() {
  case "$(limactl shell "$VM_NAME" uname -m)" in
    x86_64) echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    *) echo "scraps: unsupported worker VM architecture" >&2; exit 1 ;;
  esac
}

build_bundle() {
  local stage=$1 arch=$2
  "$ROOT/scripts/build-worker-bundle" "$arch" "$stage/worker.tar.gz" >/dev/null
}

copy_bundle() {
  local stage=$1
  limactl copy "$stage/worker.tar.gz" "$VM_NAME:/tmp/scraps-worker.tar.gz"
}

deploy_guest() {
  limactl shell "$VM_NAME" bash -s <<'GUEST'
set -euo pipefail
stage=$(mktemp -d)
trap 'rm -rf -- "$stage" /tmp/scraps-worker.tar.gz' EXIT
tar -xzf /tmp/scraps-worker.tar.gz -C "$stage"
# Migrate the pre-bundle Lima deployment once. Stop both generations before
# copying SQLite/WAL and OpenShell state so existing workspaces and GitHub App
# configuration survive the service-user transition.
sudo systemctl stop scrapd.service 2>/dev/null || true
systemctl --user stop scrapd.service openshell-gateway.service 2>/dev/null || true
sudo install -d -m 0750 /var/lib/scraps/scrapd /var/lib/scraps/openshell
if ! sudo test -e /var/lib/scraps/.lima-user-migrated; then
  [[ ! -d "$HOME/.config/scrapd" ]] || sudo cp -a "$HOME/.config/scrapd/." /var/lib/scraps/scrapd/
  [[ ! -d "$HOME/.local/state/openshell" ]] || sudo cp -a "$HOME/.local/state/openshell/." /var/lib/scraps/openshell/
  sudo touch /var/lib/scraps/.lima-user-migrated
fi
systemctl --user disable scrapd.service openshell-gateway.service >/dev/null 2>&1 || true
# The host-loopback-only Lima transport does not need a bearer token. Remote
# workers let the installer generate one and must retain it with Tailscale ACLs.
sudo install -d -m 0750 /etc/scraps
printf '%s\n' 'SCRAPD_LISTEN_ADDR=127.0.0.1:8484' 'SCRAPD_DATA_DIR=/var/lib/scraps/scrapd' \
  'SCRAPD_OPENSHELL_IMAGE=scraps-dev:bootstrap' 'SCRAPD_TOKEN=' | sudo tee /etc/scraps/scrapd.env >/dev/null
sudo chmod 0640 /etc/scraps/scrapd.env
sudo "$stage/install"
GUEST
}

up() {
  require_lima
  start_vm
  local arch
  STAGE=$(mktemp -d)
  trap 'rm -rf -- "${STAGE:-}"' EXIT
  arch=$(guest_arch)
  echo "building Scraps worker bundle for linux/$arch..."
  build_bundle "$STAGE" "$arch"
  copy_bundle "$STAGE"
  deploy_guest
  echo "Scraps worker VM ready -> http://127.0.0.1:8484"
  rm -rf -- "$STAGE"
  trap - EXIT
}

case "${1:-}" in
  up) up ;;
  stop)
    require_lima
    [[ "$(vm_status)" == Running ]] && limactl stop "$VM_NAME" || true
    ;;
  delete)
    require_lima
    [[ -n "$(vm_status)" ]] && limactl delete --force "$VM_NAME" || true
    ;;
  status)
    require_lima
    status=$(vm_status)
    echo "${status:-Not created}"
    ;;
  shell)
    require_lima
    limactl shell "$VM_NAME"
    ;;
  *) usage >&2; exit 2 ;;
esac
