#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
REMOTE=${1:-}
[[ -n $REMOTE ]] || { echo "usage: scripts/configure-remote-client user@worker-host" >&2; exit 2; }
SCRAP_BIN=${SCRAP_BIN:-"$ROOT/bin/scrap"}
[[ -x $SCRAP_BIN ]] || {
  echo "scrap CLI is not built at $SCRAP_BIN; run make build" >&2
  exit 1
}

# Keep one attachment path: it retrieves the protected connection profile and
# clones the allowlisted local Pi runner profile over the same SSH/Tailscale
# trust boundary.
exec "$SCRAP_BIN" attach "$REMOTE"
